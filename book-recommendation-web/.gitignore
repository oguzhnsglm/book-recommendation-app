# Root .gitignore for Python + Next.js monorepo

# Node / Next.js
node_modules/
.next/
.turbo/
out/
dist/
.vercel/
coverage/
.eslintcache
.stylelintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Generic cache
**/.cache/

# Environment files
.env
.env.*
!.env.example

# OS junk
.DS_Store
Thumbs.db

# Editors/IDE
.vscode/
.idea/
*.swp

# Python
__pycache__/
*.py[cod]
*.pyd
.python-version
.pytest_cache/
.mypy_cache/
.pyre/
.ipynb_checkpoints/
.venv/
venv/
env/
build/
dist/
.eggs/
*.egg-info/

# Logs
logs/
*.log

